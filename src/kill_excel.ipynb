   "source": [
    "## Terminate all excel.exe process in Task Manager - Python [closed]\n",
    "\n",
    "#### https://stackoverflow.com/questions/60502470/terminate-all-excel-exe-process-in-task-manager-python"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "1c4c8734-9308-4aa4-b766-fbf7d7a9d763",
   "metadata": {},
   "outputs": [],
   "source": [
    "import psutil\n",
    "\n",
    "for proc in psutil.process_iter():\n",
    "    if proc.name() == \"excel.exe\":\n",
    "        proc.kill()"
   ]
